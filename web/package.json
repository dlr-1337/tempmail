{
  "name": "tempmail-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "tempmail frontend — SvelteKit 2 + Svelte 5 static SPA",
  "license": "MIT",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
