# =============================================================================
# tempmail environment configuration
# -----------------------------------------------------------------------------
# Copy to `.env` and fill in the required values. Never commit `.env` — it's
# in .gitignore. The schema is enforced by src/config.ts (zod) at startup; a
# misconfigured var fails fast with a readable error list.
# =============================================================================

# --- REQUIRED ----------------------------------------------------------------

# The single domain tempmail accepts mail for and serves the SPA from.
# Example: tempmail.example.org   (production)
#          tempmail.local         (local smoke-test via docker-compose.local.yml)
DOMAIN=tempmail.example.org

# Random hex string (>= 16 chars). Used as a salt when hashing inbox ids /
# local-parts for PII-safe log lines (SMTP + admin). Rotate per deploy.
#   openssl rand -hex 32
PII_LOG_SALT=CHANGE_ME_generate_via_openssl_rand_hex_32

# Signing secret for Fastify's cookie plugin. >= 16 chars.
#   openssl rand -hex 32
COOKIE_SECRET=CHANGE_ME_generate_via_openssl_rand_hex_32

# --- RETENTION ---------------------------------------------------------------
# How long an inbox survives with no activity (sliding TTL), and the absolute
# ceiling past which it expires regardless of activity. HARD_TTL_MS must be
# >= IDLE_TTL_MS.
IDLE_TTL_MS=600000      # 10 minutes
HARD_TTL_MS=3600000     # 60 minutes

# --- DATA PATHS --------------------------------------------------------------
# Inside the container, /data is a persistent named volume. DB_PATH and
# ATTACHMENTS_DIR default to /data/tempmail.db and /data/attachments — only
# override if you know what you're doing.
DATA_DIR=/data
# DB_PATH=/data/tempmail.db
# ATTACHMENTS_DIR=/data/attachments

# --- LISTEN ------------------------------------------------------------------
# Inside the container. Compose maps 25:25 (prod) or 2525:25 (local) to the
# host. HTTP stays internal — Caddy reverse-proxies.
SMTP_PORT=25
SMTP_HOST=0.0.0.0
HTTP_PORT=8080
HTTP_HOST=0.0.0.0

# --- TLS for SMTP STARTTLS ---------------------------------------------------
# In production, point these at the Let's Encrypt cert for your MX hostname
# (which is DOMAIN for a single-host deploy). See ops/DEPLOY.md for how to
# share Caddy's issued cert with the app. For local dev, set
# TLS_DEV_SELF_SIGNED=true and leave TLS_CERT_PATH / TLS_KEY_PATH blank.
TLS_DEV_SELF_SIGNED=false
# TLS_CERT_PATH=/data/tls/fullchain.pem
# TLS_KEY_PATH=/data/tls/privkey.pem

# --- SMTP tuning -------------------------------------------------------------
MAX_MESSAGE_BYTES=10485760    # 10 MiB
SMTP_TOKENS_PER_MINUTE=10
SMTP_BURST=20
SMTP_SOCKET_TIMEOUT_MS=60000
SMTP_CLOSE_TIMEOUT_MS=30000

# --- ADMIN -------------------------------------------------------------------
# Loopback-only admin POST /admin/blocklist. Leave disabled unless you've read
# ops/DEPLOY.md `#admin` section. Never expose through Caddy.
ADMIN_ENABLED=false

# --- CADDY (read by ops/Caddyfile + docker-compose) --------------------------
# Email sent to Let's Encrypt for cert expiry warnings. Required in prod.
LETS_ENCRYPT_EMAIL=ops@example.org

# --- MISC --------------------------------------------------------------------
NODE_ENV=production
# LOG_LEVEL=info   # one of trace|debug|info|warn|error|fatal
